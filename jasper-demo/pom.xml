<?xml version="1.0" encoding="UTF-8"?>
<!--
  独立的最小工程：只用于演示 JasperReports 报表引擎（不改动主工程 pom.xml）。
  跑法见 JasperSalesReport 类注释（mvn compile 后用 java -cp 执行）。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>
  <groupId>com.ds.demo</groupId>
  <artifactId>jasper-sales-report</artifactId>
  <version>0.1</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <!-- 报表引擎本体：模板编译(.jrxml→.jasper)、数据填充、PDF/XLSX/HTML 导出 -->
    <dependency>
      <groupId>net.sf.jasperreports</groupId>
      <artifactId>jasperreports</artifactId>
      <version>6.21.3</version>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <version>42.7.4</version>
    </dependency>
    <!-- XLSX 导出：JRXlsxExporter 需要 POI（jasperreports 里是 optional 依赖，需显式引入） -->
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi-ooxml</artifactId>
      <version>4.1.2</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.1.0</version>
        <configuration>
          <mainClass>com.ds.demo.JasperSalesReport</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
