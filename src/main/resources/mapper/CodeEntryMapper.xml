<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ds.huffman.db.CodeEntryMapper">

    <!-- 批量插入：<foreach> 拼接多组 VALUES -->
    <insert id="batchInsert">
        INSERT INTO code_table (doc_id, ch, code) VALUES
        <foreach collection="list" item="e" separator=",">
            (#{e.docId}, #{e.ch}, #{e.code})
        </foreach>
    </insert>

    <!-- 查询某文档编码表，按编码长度升序、字符升序 -->
    <select id="selectByDocId" resultType="com.ds.huffman.db.CodeEntry">
        SELECT doc_id AS docId, ch, code
        FROM code_table
        WHERE doc_id = #{docId}
        ORDER BY CHAR_LENGTH(code), ch
    </select>

</mapper>
